# Copiar a .env y ajustar valores

PORT=4000
# Con PUBLIC_DOMAIN (DuckDNS/Caddy) DEBE ser production (la API hace FATAL si no).
NODE_ENV=development
# Listen HTTP(S): vacio = 127.0.0.1 en production/PUBLIC_DOMAIN; 0.0.0.0 en dev.
# LISTEN_HOST=127.0.0.1
# Dev LAN directo (junto con TPX_FW_DEV=1 / TPX_LISTEN_ALL=1):
# LISTEN_HOST=0.0.0.0
# Con PUBLIC_DOMAIN/production, LISTEN_HOST=0.0.0.0 se ignora salvo:
# TPX_LISTEN_UNSAFE=1

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tacticalptx_db

# Redis (presencia PTT, floor control)
REDIS_URL=redis://127.0.0.1:6379

# JWT — en production: ≥32 chars, no usar valores de ejemplo
JWT_SECRET=cambiar-en-produccion-minimo-32-caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# LiveKit — local o cloud
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# E2EE de voz (HMAC por room). En producción: ≥32 chars aleatorios.
LIVEKIT_E2EE_SECRET=cambiar-livekit-e2ee-minimo-32-caracteres
# Solo si LiveKit termina TLS en :7880 (no el caso del stack LAN/UPnP actual).
# La consola HTTPS usa proxy Vite (wss same-origin → ws://127.0.0.1:7880); no hace falta.
# LIVEKIT_FORCE_WSS=1
# Misma IP para web LAN y móvil 4G (recomendado con UPnP; ICE/node-ip):
# LIVEKIT_PUBLIC_HOST=189.152.200.238
# LIVEKIT_LAN_HOST=192.168.1.77
# Dominio publico (Caddy / DuckDNS) + LAN Ethernet fija del host:
# PUBLIC_DOMAIN=pulsanet.duckdns.org
# PUBLIC_LAN_IP=192.168.1.77
# PUBLIC_LAN_IPV6=
# STABLE_PUBLIC_DOMAIN=1
# DUCKDNS_SUBDOMAIN=pulsanet
# DUCKDNS_TOKEN=
# Override completo de URL (móvil/API). Web HTTPS ignora el scheme ws y usa proxy.
# LIVEKIT_PUBLIC_URL=wss://189.152.200.238.sslip.io
# Cifrado AES-256-GCM de chat/DM en base de datos. En producción: ≥32 chars.
CONTENT_ENCRYPTION_KEY=cambiar-content-aes-minimo-32-caracteres

# Cifrado AES de eventos socket sensibles (GPS/pánico). En producción: ≥32 chars.
# Activo automáticamente si hay WIRE_ENCRYPTION_KEY (salvo WIRE_ENCRYPTION=0).
WIRE_ENCRYPTION_KEY=cambiar-wire-aes-minimo-32-caracteres
# WIRE_ENCRYPTION=1

# HTTPS entre hosts (PEM). Generar: node infra/generate-lan-certs.mjs
# TLS_CERT=C:\pulsanet\infra\certs\lan-cert.pem
# TLS_KEY=C:\pulsanet\infra\certs\lan-key.pem

# Consola web pública (GET / de la API redirige aquí con 302).
# Remoto/4G: HTTPS (Vite usa infra/certs). Localhost HTTP sigue OK para mic.
# WEB_PUBLIC_URL=https://189.152.200.238.sslip.io

# CORS (web despacho + apps) — con TLS añadir https://IP:5173 y https://IP:4000
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:3000

# Detras de Caddy/nginx (borde publico): TRUST_PROXY=1
# Si PUBLIC_DOMAIN esta definido, trust proxy se activa solo salvo TRUST_PROXY=0
TRUST_PROXY=1

# Firebase Cloud Messaging (opcional)
# Opción A: ruta a JSON de service account
FIREBASE_SERVICE_ACCOUNT=
# Opción B: variables sueltas (private key con \n escapados)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limit global / 15 min (por sesión vía cola firma JWT; sin Bearer = por IP).
# Default prod ~2000+ (consola: locations ~5s + overview 15s + track). Subir si hace falta.
RATE_LIMIT_MAX=2000
# Intentos de login por IP / 15 min
LOGIN_RATE_MAX=25

# Actualizaciones APK en la app (manifiesto android.json + files/*.apk).
# Por defecto: backend/app-updates. Puede apuntar a Soporte/APK si ahí publicas.
# APP_UPDATES_DIR=C:\pulsanet\backend\app-updates
# Secreto OTA (≥32). Header X-App-Update-Key en la app (--dart-define=APP_UPDATE_SECRET=...).
# Obligatorio en NODE_ENV=production. Generar: infra\HARDEN.ps1
APP_UPDATE_SECRET=cambiar-app-update-secret-minimo-32-caracteres
APP_UPDATE_RATE_MAX=40
APP_UPDATE_TOKEN_TTL_SEC=900

# Host público (redirect / y docs). Preferir WEB_PUBLIC_URL completo.
# PUBLIC_HOST=189.152.200.238
# WEB_PUBLIC_URL=https://189.152.200.238.sslip.io
# LIVEKIT_PUBLIC_HOST=189.152.200.238

# --- Seguridad / intrusión ---
# Tras N fallos de login (por IP o usuario) en la ventana → lockdown automático
INTRUSION_MAX_FAIL_IP=12
INTRUSION_MAX_FAIL_USER=8
INTRUSION_FAIL_WINDOW_SEC=600
# Secreto para desbloquear (POST /api/security/unlock). ≥16 chars. Obligatorio si usas lockdown.
LOCKDOWN_UNLOCK_SECRET=cambia-este-secreto-desbloqueo-minimo-16
# IDs UUID de usuarios a avisar por FCM (vacío = todos root/admin activos)
# SECURITY_ALERT_USER_IDS=
# Si =1, al lockdown la API intenta lanzar infra/LOCKDOWN.ps1 (cierra firewall/UPnP/procesos)
# En production con ALLOW_HOST_LOCKDOWN=1 el unlock secret NO puede ser el de ejemplo.
ALLOW_HOST_LOCKDOWN=0

# --- Respaldos (Configuración → Respaldos) ---
# Carpeta relativa a backend/ (default: data/backups)
# BACKUP_DIR=data/backups
# PG_DUMP_BIN=C:\Program Files\PostgreSQL\18\bin\pg_dump.exe
# PSQL_BIN=C:\Program Files\PostgreSQL\18\bin\psql.exe
# BACKUP_UPLOAD_MAX_MB=2048
# Límite al subir un .zip/.sql para restaurar (MB). Default 2048 (2 GB) por multimedia en uploads/.
# Subir si los respaldos con avatares/chat/grabaciones superan 2 GB (p. ej. 4096).
# BACKUP_SPAWN_TIMEOUT_MS=1800000

# --- Ruta historica / tramos predictivos (Consola de Operaciones) ---
# Servicio de routing para los tramos sin senal (naranja). Preferir OSRM propio
# en LAN; los demos publicos solo sirven si el Host tiene internet.
# ROUTING_OSRM_URL=http://127.0.0.1:5000
# Lista CSV opcional de bases OSRM adicionales (despues de ROUTING_OSRM_URL).
# ROUTING_OSRM_FALLBACKS=http://192.168.1.10:5000
# Con OSRM propio, por defecto NO se consulta el demo publico. Pon 1 para permitirlo.
# ROUTING_OSRM_ALLOW_PUBLIC=0
# ROUTING_ENABLED=0 desactiva OSRM: se dibuja corredor estimado (punteado), no calles.
# ROUTING_ENABLED=1
# ROUTING_PROFILE=driving
# ROUTING_TIMEOUT_MS=20000
# TRACK_POST_SIMPLIFY_JUMP_M=700
# Umbrales para considerar que se perdio la senal (el latido GPS es de 5 s)
# TRACK_GAP_MIN_SECONDS=120
# TRACK_GAP_MIN_METERS=300
# TRACK_GAP_JUMP_METERS=1000
