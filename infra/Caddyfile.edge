# TacticalPtx — borde HTTPS publico (Caddy + Let's Encrypt)
# Host: {$PUBLIC_DOMAIN}  (default IP.sslip.io)
# Upstreams: {$API_UPSTREAM} {$WEB_UPSTREAM}  (default HTTPS local + skip verify)
# No poner email @*.local — Let's Encrypt lo rechaza.

{
	servers {
		protocols h1 h2
	}
}

{$PUBLIC_DOMAIN} {
	encode gzip

	handle /api* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /socket.io* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /rtc* {
		reverse_proxy http://127.0.0.1:7880 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}
