# Copiar a .env.prod y rellenar antes de: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

POSTGRES_USER=tacticalptx
POSTGRES_PASSWORD=cambia-esta-password-fuerte
POSTGRES_DB=tacticalptx_db

JWT_SECRET=cambia-este-jwt-secret-minimo-32-caracteres
JWT_EXPIRES_IN=8h

# Orígenes del panel web (dominio público)
CORS_ORIGINS=http://localhost,https://tu-dominio.example

# Clientes usan el host público de LiveKit (no el hostname interno Docker)
LIVEKIT_URL=wss://tu-dominio.example:7880
LIVEKIT_API_KEY=tacticalptxkey
LIVEKIT_API_SECRET=tacticalptxsecret_cambiar_en_produccion_minimo_32
LIVEKIT_E2EE_SECRET=cambia-livekit-e2ee-minimo-32-caracteres-aleatorios

CONTENT_ENCRYPTION_KEY=cambia-content-aes-minimo-32-caracteres-aleatorios
WIRE_ENCRYPTION_KEY=cambia-wire-aes-minimo-32-caracteres-aleatorios

# TLS (PEM) delante o en la API Node
# TLS_CERT=/certs/fullchain.pem
# TLS_KEY=/certs/privkey.pem

RATE_LIMIT_MAX=300
