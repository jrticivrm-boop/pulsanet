# TacticalPtx Ã¢â‚¬â€ borde HTTPS publico (Caddy + Let's Encrypt)
# Generado/ajustado por START-PUBLIC-EDGE.ps1 (no editar a mano en caliente).
# Plantilla: Caddyfile.edge.template (si existe) o este archivo.
# Hosts: {$PUBLIC_DOMAIN} (LE) + {$PUBLIC_LAN_IP} (tls internal, acceso LAN)

{
	servers {
		protocols h1
	}
}

{$PUBLIC_DOMAIN} {
	encode gzip

	# /api* y /socket.io* SIEMPRE al Node API â€” nunca al SPA (Vite/web).
	# Si faltan, el mÃ³vil ve HTML 404 en lugar de JSON.
	handle /api* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /socket.io* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /rtc* {
		reverse_proxy http://127.0.0.1:7880 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# Acceso por IP LAN (misma Wiâ€‘Fi/cable). Certificado interno (aceptar aviso del navegador).
# DHCP Deco 68.x + Ethernet 1.x + alias histÃ³ricos.
{$PUBLIC_LAN_IP}, {$PUBLIC_LAN_IPV6}, 192.168.1.77 {
	tls internal
	encode gzip

	# /api* â†’ Node API (mismo criterio que el sitio pÃºblico).
	handle /api* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /socket.io* {
		reverse_proxy {$API_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}

	handle /rtc* {
		reverse_proxy http://127.0.0.1:7880 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}



