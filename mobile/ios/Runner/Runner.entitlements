<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push APNs.
	     development = debug / dispositivo conectado a Xcode.
	     Codemagic / Archive → App Store: Xcode o el perfil de distribución
	     suelen sustituir por «production» al firmar. Si el push falla en TestFlight
	     y el IPA quedó en development, cambia a production solo en Release. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
